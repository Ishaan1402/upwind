# Secrets & local env
.env
.env.local
.env.*.local

# Python
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# App caches / local DB (auto-created at runtime — do not commit)
backend/cache.db
upwind.db
*.db-journal

# Frontend build & deps (also covered under frontend/.gitignore)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
