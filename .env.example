# API Keys for AQI "Show Why"
AIRNOW_KEY=your_airnow_api_key_here
OPENAQ_API_KEY=your_openaq_api_key_here
FIRMS_MAP_KEY=your_firms_map_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# Groq retired llama-3.3-70b-versatile / llama-3.1-8b-instant on 2026-08-16.
JUDGE_MODEL=openai/gpt-oss-120b
JUDGE_FALLBACK_MODEL=openai/gpt-oss-20b
PORT=8000

# CORS & Abuse Protection
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_AQI_PER_MIN=60
RATE_LIMIT_WHY_PER_HOUR=8
TRUST_PROXY=0

# Metrics cost estimation (USD per 1M tokens); used only for the dashboard.
LLM_INPUT_PRICE_PER_1M=0.27
LLM_OUTPUT_PRICE_PER_1M=1.10
LLM_JUDGE_INPUT_PRICE_PER_1M=0.15
LLM_JUDGE_OUTPUT_PRICE_PER_1M=0.60

# Raw metric event rows are pruned after this many days.
METRICS_RETENTION_DAYS=90

# Short-lived observation tokens for the Why APIs. Set a strong random secret
# and flip ENFORCE_OBSERVATION_TOKENS=1 in production.
OBSERVATION_TOKEN_SECRET=
OBSERVATION_TOKEN_MAX_AGE_SECONDS=600
ENFORCE_OBSERVATION_TOKENS=0

# SQLite database
# Narrative + geocode cache is written to backend/cache.db on first run.
# Copy this file to .env only; never commit .env or *.db files.
